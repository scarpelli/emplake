rules_version = '2';

// Each player reads and writes only their own documents:
//   users/{uid}                      profile and counters
//   users/{uid}/solved/{level_nnnn}  solved numbers
//   users/{uid}/skipped/{level_nnnn} skipped numbers
//   users/{uid}/daily/{yyyy-mm-dd}   plate of the day attempts
//   dailyStats/{yyyy-mm-dd}          everyone's plate of the day tally
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validLevel(level) {
      return level in ['easy', 'intermediate', 'advanced', 'hard'];
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /solved/{entry} {
        allow read: if isOwner(uid);
        // Solved entries are created once and never edited.
        allow create: if isOwner(uid)
          && request.resource.data.number is string
          && request.resource.data.number.size() == 4
          && validLevel(request.resource.data.level)
          && entry == request.resource.data.level + '_' + request.resource.data.number
          && request.resource.data.points is int
          && request.resource.data.points >= 0
          && request.resource.data.points <= 100;
        allow update, delete: if false;
      }

      match /skipped/{entry} {
        allow read, write: if isOwner(uid);
      }

      // Plate of the day, one document per UTC date (yyyy-mm-dd).
      match /daily/{day} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
    }

    // Public tally of the plate of the day: players and solve-time buckets.
    // Any signed-in player may add to it, never shrink it.
    match /dailyStats/{day} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['plays', 'missed', 'times'])
        && request.resource.data.plays == (resource == null ? 0 : resource.data.get('plays', 0)) + 1;
    }
  }
}
